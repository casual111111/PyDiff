    "version": "0.2.0",
    "configurations": [

        {
            "name": "train_v1.yaml",
            "type": "python",
            "request": "launch",
            "module": "torch.distributed.launch",
            "console": "integratedTerminal",
            "python": "/root/miniconda3/envs/PyDiff/bin/python",
            "cwd": "${workspaceFolder}/PyDiff",
            "env": {
                "CUDA_VISIBLE_DEVICES": "0,1",
                "PYTHONPATH": "${workspaceFolder}/PyDiff:${env:PYTHONPATH}"
            },
            "args": [
                "--nproc_per_node=2",
                "--master_port=22666",
                "pydiff/train.py",
                "-opt",
                "options/train_v1.yaml",
                "--launcher",
                "pytorch",
                "--writer_name",
                "base_LLIE"
            ]
        }
    ]
}